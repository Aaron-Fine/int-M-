/-- The lower multiplier chain of `boundaryPeriodThreeTile` passes by kernel reduction. -/
theorem boundaryPeriodThreeTile_lower_check :
    checkTileMultiplierLower boundaryPeriodThreeTile 16492199242371852392
      boundaryPeriodThreeTileLower = true := by
  decide +kernel

/-- Two-sided multiplier enclosure near the boundary: for every parameter within `2^-20` of
the dyadic reference, the seed disk contains exactly one fixed point `ζ` of the three-step
return; it has minimal period three and `89/100 ≤ ‖λ(ζ)‖ ≤ 91/100`. -/
theorem boundaryPeriodThreeTile_multiplier_bounds (c : ℂ)
    (hc : ‖c - dyadicDecode 64 boundaryPeriodThreeTile.parameter‖ ≤ 1 / 1048576) :
    ∃! ζ : ℂ, ζ ∈ closedBall (dyadicDecode 64 boundaryPeriodThreeTile.center)
        (dyadicNatDecode 64 boundaryPeriodThreeTile.seedRadius) ∧
      orbit c 3 ζ = ζ ∧
      (∀ y ∈ closedBall (dyadicDecode 64 boundaryPeriodThreeTile.center)
          (dyadicNatDecode 64 boundaryPeriodThreeTile.seedRadius),
        orbit c 3 y = y → y = ζ) ∧
      minimalPeriod (quadratic c) ζ = 3 ∧
      (89 / 100 : ℝ) ≤ ‖(derivative (seedPolynomial c 3)).eval ζ‖ ∧
      ‖(derivative (seedPolynomial c 3)).eval ζ‖ ≤ 91 / 100 := by
  have hprec : boundaryPeriodThreeTile.precision = 64 := rfl
  have hΔ : boundaryPeriodThreeTile.parameterRadius = 17592186044416 := rfl
  have hq : boundaryPeriodThreeTile.contraction = 16712153827789027403 := rfl
  have hperiod : boundaryPeriodThreeTile.period = 3 := rfl
  have h := checkTile_sound_multiplier_bounds boundaryPeriodThreeTile 16492199242371852392
    boundaryPeriodThreeTileLower boundaryPeriodThreeTile_check
    boundaryPeriodThreeTile_lower_check c
    (by rw [hprec, hΔ]; norm_num [dyadicNatDecode]; exact hc)
  rw [hprec, hq, hperiod] at h
  have hlo : (89 / 100 : ℝ) ≤ dyadicNatDecode 64 16492199242371852392 := by
    norm_num [dyadicNatDecode]
  have hhi : dyadicNatDecode 64 16712153827789027403 ≤ 91 / 100 := by
    norm_num [dyadicNatDecode]
  obtain ⟨ζ, hζ, honly⟩ := h
  exact ⟨ζ, ⟨hζ.1, hζ.2.1, hζ.2.2.1, hζ.2.2.2.1, hlo.trans hζ.2.2.2.2.1,
    hζ.2.2.2.2.2.trans hhi⟩, fun y hy => hζ.2.2.1 y hy.1 hy.2.1⟩

