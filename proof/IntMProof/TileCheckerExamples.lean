/-- The rational rectangle `periodTwoRationalTile` lies in the emitted rectangle about `-1`
with half-widths `2^-32`, so every complex parameter in it receives the checked trap with
seed disk `‖z‖ ≤ 1/16` (containing no other fixed point of the two-step return), critical
entry at iterate `2`, and contraction bound `1/2`: the critical orbit returns to the disk at
iterates `2 + 2m` and contracts to `ζ` at rate `(1/2)^m`. -/
theorem minusOnePeriodTwoTile_complex_trap (c : ℂ) (hc : periodTwoRationalTile.contains c) :
    ∃! ζ : ℂ, ζ ∈ closedBall (0 : ℂ) (1 / 16 : ℝ) ∧ orbit c 2 ζ = ζ ∧
      (∀ y ∈ closedBall (0 : ℂ) (1 / 16 : ℝ), orbit c 2 y = y → y = ζ) ∧
      minimalPeriod (quadratic c) ζ = 2 ∧
      ‖(derivative (seedPolynomial c 2)).eval ζ‖ ≤ 1 / 2 ∧
      ∀ m : ℕ, orbit c (2 + m * 2) 0 ∈ closedBall (0 : ℂ) (1 / 16 : ℝ) ∧
        dist (orbit c (2 + m * 2) 0) ζ ≤ (1 / 2 : ℝ) ^ m * dist (orbit c 2 0) ζ := by
  have hprec : minusOnePeriodTwoTile.precision = 64 := rfl
  have hparam : minusOnePeriodTwoTile.parameter = ⟨-18446744073709551616, 0⟩ := rfl
  have hcenter : minusOnePeriodTwoTile.center = ⟨0, 0⟩ := rfl
  have hradius : minusOnePeriodTwoTile.seedRadius = 1152921504606846976 := rfl
  have hq : minusOnePeriodTwoTile.contraction = 9223372036854775808 := rfl
  have hperiod : minusOnePeriodTwoTile.period = 2 := rfl
  have hentry : minusOnePeriodTwoTile.entry = 2 := rfl
  rcases hc with ⟨⟨hrelo, hrehi⟩, ⟨himlo, himhi⟩⟩
  simp only [periodTwoRationalTile] at hrelo hrehi himlo himhi
  push_cast at hrelo hrehi himlo himhi
  have h := checkTile_sound_rectangle minusOnePeriodTwoTile minusOnePeriodTwoTile_check
    4294967296 4294967296 minusOnePeriodTwoTile_rectangle c
    (by
      rw [hprec, hparam]
      simp only [dyadicDecode, dyadicNatDecode]
      rw [abs_le]
      constructor <;> norm_num <;> linarith)
    (by
      rw [hprec, hparam]
      simp only [dyadicDecode, dyadicNatDecode]
      rw [abs_le]
      constructor <;> norm_num <;> linarith)
  rw [hprec, hcenter, hradius, hq, hperiod, hentry] at h
  have hz : dyadicDecode 64 ⟨0, 0⟩ = 0 := by
    simp [dyadicDecode, Complex.ext_iff]
  have hr : dyadicNatDecode 64 1152921504606846976 = 1 / 16 := by
    norm_num [dyadicNatDecode]
  have hq' : dyadicNatDecode 64 9223372036854775808 = 1 / 2 := by
    norm_num [dyadicNatDecode]
  rwa [hz, hr, hq'] at h

