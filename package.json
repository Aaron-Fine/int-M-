{
  "name": "mandelbrot-interiority",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An evidence-aware explorer for the interior dynamics of the Mandelbrot set.",
  "license": "GPL-3.0-only",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=12.1.0 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:assets",
    "build:assets": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.poc.json",
    "catalog:test": "python3 -m unittest discover -s tools -p 'test_*.py'",
    "catalog:check": "python3 tools/generate_catalog.py --check catalog/components.v2.json",
    "fixtures:check": "python3 tools/generate_orbit_fixtures.py --check fixtures/orbits.v1.json",
    "poc:perf": "node poc/performance/src/run.ts",
    "poc:bench:pr2": "vite build --ssr poc/performance/src/pr2-bench.ts --outDir .evidence-build --emptyOutDir && node --expose-gc .evidence-build/pr2-bench.js",
    "bench:recorder": "vite build --ssr tools/benchmark/recorder-cost.ts --outDir .evidence-build --emptyOutDir && node .evidence-build/recorder-cost.js",
    "evidence:cpu": "vite build --ssr tools/measure_cpu.ts --outDir .evidence-build --emptyOutDir && node .evidence-build/measure_cpu.js",
    "evidence:release": "node tools/benchmark/run-release.ts --release",
    "evidence:smoke": "node tools/benchmark/run-release.ts --reps 2 --out-dir test-results/evidence-smoke --cases mi-easy-default-full,mi-hard-supplied-126x",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:watch": "vitest",
    "test:browser": "playwright test --pass-with-no-tests",
    "test:browser:dev": "PLAYWRIGHT_DEV_SERVER=1 playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:container": "bash tools/run-visual-container.sh",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run catalog:test && npm run catalog:check && npm run fixtures:check && npm run fixtures:golden:check && npm run test:unit && npm run build:assets",
    "evidence:early-accept": "vite build --ssr tools/measure_early_accept.ts --outDir .evidence-build --emptyOutDir && node --max-old-space-size=1536 .evidence-build/measure_early_accept.js",
    "tournament": "vite build --ssr tools/benchmark/tournament.ts --outDir .evidence-build/tournament --emptyOutDir && node --expose-gc --max-old-space-size=1536 .evidence-build/tournament/tournament.js",
    "fixtures:kernel-golden": "vite build --ssr tools/generate_kernel_golden.ts --outDir .evidence-build/kernel-golden --emptyOutDir --logLevel warn && node .evidence-build/kernel-golden/generate_kernel_golden.js",
    "fixtures:golden:check": "npm run fixtures:kernel-golden -- --check && npm run fixtures:colorized-golden -- --check",
    "fixtures:colorized-golden": "vite build --ssr tools/generate_colorized_golden.ts --outDir .evidence-build/colorized-golden --emptyOutDir --logLevel warn && node .evidence-build/colorized-golden/generate_colorized_golden.js",
    "evidence:palette": "vite build --ssr tools/palette_metrics.ts --outDir .evidence-build/palette --emptyOutDir --logLevel warn && node .evidence-build/palette/palette_metrics.js",
    "kernel-bench": "vite build --ssr tools/benchmark/kernel-bench.ts --outDir .evidence-build/kernel-bench --emptyOutDir --logLevel warn && node .evidence-build/kernel-bench/kernel-bench.js",
    "fixtures:pixel-dump": "vite build --ssr tools/kernel_pixel_dump.ts --outDir .evidence-build/pixel-dump --emptyOutDir --logLevel warn && node .evidence-build/pixel-dump/kernel_pixel_dump.js",
    "evidence:period-three": "vite build --ssr tools/adjudicate_period_three.ts --outDir .evidence-build/period-three --emptyOutDir --logLevel warn && node .evidence-build/period-three/adjudicate_period_three.js",
    "evidence:period-four": "vite build --ssr tools/adjudicate_period_four.ts --outDir .evidence-build/period-four --emptyOutDir --logLevel warn && node .evidence-build/period-four/adjudicate_period_four.js",
    "coarse-budget-study": "vite build --ssr tools/benchmark/coarse-budget-study.ts --outDir .evidence-build/coarse-budget-study --emptyOutDir --logLevel warn && node .evidence-build/coarse-budget-study/coarse-budget-study.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
